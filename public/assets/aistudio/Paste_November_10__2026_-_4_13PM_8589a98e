// Gerador pseudoaleatório Xorshift32 ultrarrápido (1 ciclo de máquina)
struct FastRng {
    state: u32,
}

impl FastRng {
    #[inline(always)]
    fn new(seed: u32) -> Self {
        Self { state: if seed == 0 { 2463534242 } else { seed } }
    }

    #[inline(always)]
    fn next_u32(&mut self) -> u32 {
        let mut x = self.state;
        x ^= x << 13;
        x ^= x >> 17;
        x ^= x << 5;
        self.state = x;
        x
    }

    // Sorteia exatamente 15 bits ativos distintos dentro das dezenas selecionadas (universo V)
    #[inline(always)]
    fn sortear_15_dezenas(&mut self, dezenas_pool: &[u32]) -> u32 {
        let mut mask: u32 = 0;
        let mut count = 0;
        let total_pool = dezenas_pool.len() as u32;

        while count < 15 {
            let idx = (self.next_u32() % total_pool) as usize;
            let bit = dezenas_pool[idx];
            if (mask & bit) == 0 {
                mask |= bit;
                count += 1;
            }
        }
        mask
    }
}

#[wasm_bindgen]
pub struct MonteCarloResult {
    pub total_simulacoes: u32,
    pub acertos_15: u32,
    pub acertos_14: u32,
    pub acertos_13: u32,
    pub acertos_12: u32,
    pub acertos_11: u32,
    pub taxa_14_ou_15: f32,
}

#[wasm_bindgen]
pub fn simular_monte_carlo_wasm(
    cartoes_masks: &[u32],
    dezenas_selecionadas_bits: &[u32],
    num_simulacoes: u32,
    seed: u32,
) -> MonteCarloResult {
    let mut rng = FastRng::new(seed);
    let total_cartoes = cartoes_masks.len();

    let mut ac15 = 0;
    let mut ac14 = 0;
    let mut ac13 = 0;
    let mut ac12 = 0;
    let mut ac11 = 0;
    let mut sucessos_alvo = 0;

    for _ in 0..num_simulacoes {
        let sorteio_mask = rng.sortear_15_dezenas(dezenas_selecionadas_bits);
        let mut max_acertos = 0;

        for i in 0..total_cartoes {
            // Instrução nativa count_ones (POPCNT)
            let acertos = (cartoes_masks[i] & sorteio_mask).count_ones();
            if acertos > max_acertos {
                max_acertos = acertos;
                if max_acertos == 15 { break; }
            }
        }

        match max_acertos {
            15 => { ac15 += 1; sucessos_alvo += 1; },
            14 => { ac14 += 1; sucessos_alvo += 1; },
            13 => { ac13 += 1; },
            12 => { ac12 += 1; },
            11 => { ac11 += 1; },
            _ => {},
        }
    }

    MonteCarloResult {
        total_simulacoes: num_simulacoes,
        acertos_15: ac15,
        acertos_14: ac14,
        acertos_13: ac13,
        acertos_12: ac12,
        acertos_11: ac11,
        taxa_14_ou_15: (sucessos_alvo as f32 / num_simulacoes as f32) * 100.0,
    }
}
// monteCarloLoader.js
import init, { simular_monte_carlo_wasm } from './pkg/lotosniper_wasm.js';

export async function rodarMonteCarloWasm({
  cartoesMasks,
  dezenasSelecionadas, // ex: [1, 2, 3, 5, ..., 20] (18 dezenas)
  simulacoes = 50000
}) {
  await init();

  // Mapeia para potências de 2 (máscaras de cada dezena do universo de jogo)
  const poolBits = new Uint32Array(dezenasSelecionadas.map(d => 1 << (d - 1)));
  const cartoes = new Uint32Array(cartoesMasks);
  const seed = (Math.random() * 0xFFFFFFFF) >>> 0;

  console.time(`Monte Carlo (${simulacoes} ciclos)`);
  const res = simular_monte_carlo_wasm(cartoes, poolBits, simulacoes, seed);
  console.timeEnd(`Monte Carlo (${simulacoes} ciclos)`);

  return {
    simulacoes: res.total_simulacoes,
    acertos15: res.acertos_15,
    acertos14: res.acertos_14,
    acertos13: res.acertos_13,
    acertos12: res.acertos_12,
    acertos11: res.acertos_11,
    taxaSucesso14Mais: res.taxa_14_ou_15
  };
}

