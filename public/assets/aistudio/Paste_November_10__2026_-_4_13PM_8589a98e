import { dbService } from './database.js';

export class BackupRestoreService {
  /**
   * Exporta todo o conteúdo do IndexedDB para um arquivo JSON estruturado.
   */
  static async exportarBackupCompleto() {
    const db = await dbService.conectar();
    const stores = ['concursos', 'fechamentosSalvos', 'historicoBacktest'];
    const backupData = {
      app: 'LotoSniper',
      versaoSchema: 2,
      exportadoEm: new Date().toISOString(),
      tabelas: {}
    };

    return new Promise((resolve, reject) => {
      const tx = db.transaction(stores, 'readonly');
      let concluidas = 0;

      stores.forEach(storeName => {
        const store = tx.objectStore(storeName);
        const req = store.getAll();

        req.onsuccess = () => {
          backupData.tabelas[storeName] = req.result;
          concluidas++;
          if (concluidas === stores.length) {
            this._dispararDownload(backupData);
            resolve(backupData);
          }
        };

        req.onerror = () => reject(req.error);
      });
    });
  }

  /**
   * Lê e valida um arquivo JSON enviado pelo usuário, restaurando o banco em transação atômica.
   * @param {File} arquivoJson 
   */
  static async importarBackupJson(arquivoJson) {
    const texto = await arquivoJson.text();
    let payload;

    try {
      payload = JSON.parse(texto);
    } catch {
      throw new Error('Arquivo JSON inválido ou corrompido.');
    }

    if (!payload.app || payload.app !== 'LotoSniper' || !payload.tabelas) {
      throw new Error('Formato de backup incompatível com o LotoSniper.');
    }

    const db = await dbService.conectar();
    const stores = Object.keys(payload.tabelas);

    return new Promise((resolve, reject) => {
      const tx = db.transaction(stores, 'readwrite');

      stores.forEach(storeName => {
        if (!db.objectStoreNames.contains(storeName)) return;
        const store = tx.objectStore(storeName);
        const registros = payload.tabelas[storeName] || [];

        // Substituição / Inserção limpa
        registros.forEach(item => {
          store.put(item);
        });
      });

      tx.oncomplete = () => {
        console.log('[LotoSniper] Backup restaurado com sucesso.');
        resolve(true);
      };

      tx.onerror = () => reject(new Error(`Falha ao restaurar dados: ${tx.error}`));
    });
  }

  static _dispararDownload(data) {
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const dataIso = new Date().toISOString().split('T')[0];
    
    const link = document.createElement('a');
    link.href = url;
    link.download = `backup_lotosniper_${dataIso}.json`;
    document.body.appendChild(link);
    link.click();

    setTimeout(() => {
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    }, 100);
  }
}

