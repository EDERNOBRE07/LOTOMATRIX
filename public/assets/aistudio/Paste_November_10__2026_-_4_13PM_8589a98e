export function calcularMetricasAvancadas(curvaPatrimonial, custoTotal, arrecadacaoTotal) {
  let pico = 0;
  let maxDrawdown = 0;
  let concursosComRetorno = 0;
  let saldoAcumulado = 0;

  curvaPatrimonial.forEach(p => {
    saldoAcumulado += p.lucroLiquido;
    if (saldoAcumulado > pico) pico = saldoAcumulado;
    
    const queda = pico - saldoAcumulado;
    if (queda > maxDrawdown) maxDrawdown = queda;
    if (p.retorno > 0) concursosComRetorno++;
  });

  const saldoLiquido = arrecadacaoTotal - custoTotal;
  const roi = custoTotal > 0 ? (saldoLiquido / custoTotal) * 100 : 0;
  const taxaSucesso = (concursosComRetorno / curvaPatrimonial.length) * 100;
  const perdasTotais = curvaPatrimonial
    .filter(p => p.lucroLiquido < 0)
    .reduce((acc, p) => acc + Math.abs(p.lucroLiquido), 0);
  const ganhosTotais = curvaPatrimonial
    .filter(p => p.lucroLiquido > 0)
    .reduce((acc, p) => acc + p.lucroLiquido, 0);
  const fatorLucro = perdasTotais > 0 ? ganhosTotais / perdasTotais : ganhosTotais > 0 ? 99 : 0;

  return {
    saldoLiquido,
    roi,
    custoTotal,
    maxDrawdown,
    taxaSucesso,
    fatorLucro
  };
}

