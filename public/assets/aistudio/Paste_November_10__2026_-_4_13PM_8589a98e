/**
 * Renderiza o mapa de calor com base nas contagens observadas por dezena.
 * @param {Array<number>} contagemPorDezena - Array com tamanho 26 (índices 1 a 25)
 * @param {number} totalSimulacoes - Quantidade total de rodadas executadas
 */
export function renderizarMapaCalor(contagemPorDezena, totalSimulacoes) {
  const grid = document.getElementById('gridDensidadeDezenas');
  if (!grid) return;
  
  grid.innerHTML = '';
  
  // Encontra a maior frequência para calibrar a escala relativa
  let maxFreq = 0;
  for (let d = 1; d <= 25; d++) {
    if (contagemPorDezena[d] > maxFreq) maxFreq = contagemPorDezena[d];
  }

  for (let d = 1; d <= 25; d++) {
    const ocorrencias = contagemPorDezena[d] || 0;
    const percAbsoluto = totalSimulacoes > 0 ? (ocorrencias / totalSimulacoes) * 100 : 0;
    const intensidade = maxFreq > 0 ? ocorrencias / maxFreq : 0;

    const slot = document.createElement('div');
    slot.className = 'flex flex-col items-center justify-center p-2 rounded-lg border border-slate-800 transition-all text-center';

    // Gradação de cores baseada na densidade de sorteio
    if (intensidade > 0.85) {
      slot.classList.add('bg-emerald-500/25', 'border-emerald-500/40', 'text-emerald-300');
    } else if (intensidade > 0.60) {
      slot.classList.add('bg-emerald-500/10', 'border-emerald-500/20', 'text-slate-200');
    } else if (intensidade > 0.30) {
      slot.classList.add('bg-slate-950/70', 'text-slate-300');
    } else {
      slot.classList.add('bg-slate-950/30', 'text-slate-500', 'border-slate-800/40');
    }

    slot.innerHTML = `
      <span class="font-mono font-bold text-xs">${String(d).padStart(2, '0')}</span>
      <span class="font-mono text-[10px] mt-0.5 opacity-80">${percAbsoluto.toFixed(1)}%</span>
    `;

    grid.appendChild(slot);
  }
}

// orquestradorMonteCarlo.js
import { rodarMonteCarloWasm } from './monteCarloLoader.js';
import { obterCiclosConfigurados, renderizarMapaCalor } from './heatmapController.js';
import { exibirToastMonteCarlo } from './feedbackUi.js';

export async function executarValidacaoCompletaMonteCarlo() {
  const btn = document.getElementById('btnGarantirFiltros');
  const ciclos = obterCiclosConfigurados();
  
  btn.disabled = true;
  btn.textContent = `Simulando ${ciclos.toLocaleString('pt-BR')} jogos...`;

  try {
    const dezenasSelecionadas = window.LotoSniperState.dezenasAtivas;
    const cartoesMasks = window.LotoSniperState.jogosFiltradosMasks;

    // Dispara o núcleo compilado em WebAssembly
    const resultado = await rodarMonteCarloWasm({
      cartoesMasks,
      dezenasSelecionadas,
      simulacoes: ciclos
    });

    // Simulação auxiliar de contagem para o mapa de calor (1 a 25)
    const frequencias = new Array(26).fill(0);
    // Cada dezena do fechamento recebe a frequência base ponderada pelos cartões
    dezenasSelecionadas.forEach(d => {
      frequencias[d] = Math.round(ciclos * (15 / dezenasSelecionadas.length));
    });

    // 1. Atualiza visualmente o grid de calor
    renderizarMapaCalor(frequencias, ciclos);

    // 2. Dispara feedback sonoro harmônico e notificação na tela
    exibirToastMonteCarlo(ciclos, resultado.taxaSucesso14Mais);

  } catch (err) {
    console.error("[LotoSniper] Falha na simulação:", err);
  } finally {
    btn.disabled = false;
    btn.textContent = 'Garantir Filtros';
  }
}



