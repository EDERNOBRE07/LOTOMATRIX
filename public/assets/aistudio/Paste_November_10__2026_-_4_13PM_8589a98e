#[wasm_bindgen]
pub struct AnnealingResult {
    total_cartoes: usize,
    cobertura_alcancada: f32,
    indices_selecionados: Vec<usize>,
}

#[wasm_bindgen]
impl AnnealingResult {
    #[wasm_bindgen(getter)]
    pub fn total_cartoes(&self) -> usize {
        self.total_cartoes
    }

    #[wasm_bindgen(getter)]
    pub fn cobertura_alcancada(&self) -> f32 {
        self.cobertura_alcancada
    }

    #[wasm_bindgen(getter)]
    pub fn indices(&self) -> Vec<usize> {
        self.indices_selecionados.clone()
    }
}

#[inline(always)]
fn avaliar_solucao(
    indices: &[usize],
    pool: &[u32],
    cenarios: &[u32],
    garantia_alvo: u32,
    taxa_minima: f32,
) -> (f32, f32, bool) {
    let total_cenarios = cenarios.len();
    let mut cobertos = 0;

    for &cenario in cenarios {
        for &idx in indices {
            if popcount(cenario & pool[idx]) >= garantia_alvo {
                cobertos += 1;
                break;
            }
        }
    }

    let cobertura = (cobertos as f32 / total_cenarios as f32) * 100.0;
    let penalidade = if cobertura < taxa_minima {
        (taxa_minima - cobertura) * 800.0
    } else {
        0.0
    };
    let custo = indices.len() as f32 + penalidade;
    let valido = cobertura >= taxa_minima;

    (custo, cobertura, valido)
}

#[wasm_bindgen]
pub fn simulated_annealing_wasm(
    pool_candidatos: &[u32],
    cenarios_acerto: &[u32],
    garantia_alvo: u32,
    taxa_minima: f32,
    mut temp_inicial: f32,
    fator_resfriamento: f32,
    iter_por_temp: usize,
    temp_min: f32,
    seed: u32,
) -> AnnealingResult {
    let pool_len = pool_candidatos.len();
    let mut rng_state = seed;

    // Gerador linear congruencial rápido (LCG) sem overhead de biblioteca externa
    let mut rand_f32 = || -> f32 {
        rng_state = rng_state.wrapping_mul(1664525).wrapping_add(1013904223);
        (rng_state as f32) / (u32::MAX as f32)
    };

    // Subconjunto inicial (30% do pool)
    let init_len = (pool_len as f32 * 0.3).ceil() as usize;
    let mut solucao_atual: Vec<usize> = (0..init_len.min(pool_len)).collect();

    let (mut custo_atual, mut cob_atual, _) =
        avaliar_solucao(&solucao_atual, pool_candidatos, cenarios_acerto, garantia_alvo, taxa_minima);

    let mut melhor_solucao = solucao_atual.clone();
    let mut melhor_custo = custo_atual;
    let mut melhor_cobertura = cob_atual;

    while temp_inicial > temp_min {
        for _ in 0..iter_por_temp {
            let mut vizinho = solucao_atual.clone();
            let acao = rand_f32();

            if acao < 0.4 && vizinho.len() > 1 {
                // Remover
                let pos = (rand_f32() * vizinho.len() as f32) as usize;
                vizinho.swap_remove(pos.min(vizinho.len() - 1));
            } else if acao < 0.8 {
                // Inserir
                let item = (rand_f32() * pool_len as f32) as usize;
                if !vizinho.contains(&item) {
                    vizinho.push(item);
                }
            } else {
                // Swap
                let pos = (rand_f32() * vizinho.len() as f32) as usize;
                vizinho.swap_remove(pos.min(vizinho.len() - 1));
                let item = (rand_f32() * pool_len as f32) as usize;
                if !vizinho.contains(&item) {
                    vizinho.push(item);
                }
            }

            let (custo_vizinho, cob_vizinho, valido) =
                avaliar_solucao(&vizinho, pool_candidatos, cenarios_acerto, garantia_alvo, taxa_minima);

            let delta = custo_vizinho - custo_atual;

            if delta < 0.0 || rand_f32() < (-delta / temp_inicial).exp() {
                solucao_atual = vizinho;
                custo_atual = custo_vizinho;
                cob_atual = cob_vizinho;

                if valido && custo_atual < melhor_custo {
                    melhor_solucao = solucao_atual.clone();
                    melhor_custo = custo_atual;
                    melhor_cobertura = cob_atual;
                }
            }
        }

        temp_inicial *= fatorResfriamento(fator_resfriamento);
    }

    AnnealingResult {
        total_cartoes: melhor_solucao.len(),
        cobertura_alcancada: melhor_cobertura,
        indices_selecionados: melhor_solucao,
    }
}

#[inline(always)]
fn fatorResfriamento(f: f32) -> f32 {
    if f <= 0.0 || f >= 1.0 { 0.95 } else { f }
}
