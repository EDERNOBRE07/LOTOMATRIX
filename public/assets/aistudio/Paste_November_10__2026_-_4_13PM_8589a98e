2. Curva Patrimonial com Gráfico Subaquático de Drawdown Máximo
O cálculo contínuo de Drawdown mede o rebaixamento financeiro em relação ao topo histórico (High-Water Mark). O gráfico abaixo combina a curva de capital acumulado com a área subaquática negativa de perda máxima temporária.

 

// calculoDrawdown.js

export function gerarSeriesDrawdown(curvaPatrimonial) {
  let acumulado = 0;
  let highWaterMark = 0; // Pico histórico de lucro

  const series = {
    concursos: [],
    saldoAcumulado: [],
    drawdownSubaquatico: [],
    maxDrawdownHistorico: 0
  };

  curvaPatrimonial.forEach(p => {
    acumulado += p.lucroLiquido;
    if (acumulado > highWaterMark) {
      highWaterMark = acumulado;
    }

    // O drawdown é a distância negativa entre o ponto atual e o topo histórico
    const ddInstantaneo = acumulado - highWaterMark;

    if (Math.abs(ddInstantaneo) > series.maxDrawdownHistorico) {
      series.maxDrawdownHistorico = Math.abs(ddInstantaneo);
    }

    series.concursos.push(`#${p.concurso}`);
    series.saldoAcumulado.push(acumulado);
    series.drawdownSubaquatico.push(ddInstantaneo);
  });

  return series;
}

