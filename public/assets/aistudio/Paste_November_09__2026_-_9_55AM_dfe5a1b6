function calcularCoberturaRestante(jogosFiltradosMasks, todosCenariosAcertoMasks, garantiaAcertos) {
  let cenariosCobertos = 0;
  const totalCenarios = todosCenariosAcertoMasks.length;

  for (let i = 0; i < totalCenarios; i++) {
    const cenario = todosCenariosAcertoMasks[i];
    let coberto = false;

    for (let j = 0; j < jogosFiltradosMasks.length; j++) {
      if (popcount(cenario & jogosFiltradosMasks[j]) >= garantiaAcertos) {
        coberto = true;
        break; // Cenário atendido por ao menos um cartão
      }
    }

    if (coberto) cenariosCobertos++;
  }

  // Retorna porcentagem real de garantia
  return (cenariosCobertos / totalCenarios) * 100;
