class VirtualScroll {
  constructor({ container, phantom, content, itemHeight, items, renderItem }) {
    this.container = container;
    this.phantom = phantom;
    this.content = content;
    this.itemHeight = itemHeight;
    this.items = items;
    this.renderItem = renderItem;

    // Define a altura total virtual para habilitar a barra de rolagem nativa
    this.phantom.style.height = `${this.items.length * this.itemHeight}px`;

    this.container.addEventListener('scroll', () => this.onScroll());
    this.onScroll();
  }

  onScroll() {
    const scrollTop = this.container.scrollTop;
    const viewportHeight = this.container.clientHeight;

    // Índices visíveis com margem de segurança (buffer)
    const buffer = 4;
    const startIndex = Math.max(0, Math.floor(scrollTop / this.itemHeight) - buffer);
    const endIndex = Math.min(
      this.items.length,
      Math.ceil((scrollTop + viewportHeight) / this.itemHeight) + buffer
    );

    // Desloca a camada de conteúdo para acompanhar o scroll
    this.content.style.transform = `translateY(${startIndex * this.itemHeight}px)`;

    // Renderiza apenas os itens da fatia visível
    let html = '';
    for (let i = startIndex; i < endIndex; i++) {
      html += this.renderItem(this.items[i], i);
    }
    this.content.innerHTML = html;
  }
}

