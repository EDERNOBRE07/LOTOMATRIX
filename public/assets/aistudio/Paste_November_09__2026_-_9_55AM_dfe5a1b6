import { popcount } from './bitwiseUtils.js';

/**
 * Calcula o número exato de combinações C(n, k).
 */
function combinacoes(n, k) {
  if (k < 0 || k > n) return 0;
  if (k === 0 || k === n) return 1;
  let c = 1;
  for (let i = 1; i <= k; i++) {
    c = (c * (n - (k - i))) / i;
  }
  return Math.round(c);
}

/**
 * Gera todos os cenários C(V, 15) como um vetor tipado Int32Array contendo máscaras binárias.
 * @param {number[]} dezenasSelecionadas - Array ordenado com as dezenas escolhidas (ex: 18 dezenas)
 * @returns {Int32Array}
 */
export function gerarTodosCenariosAcerto(dezenasSelecionadas) {
  const n = dezenasSelecionadas.length;
  const k = 15;
  const totalCenarios = combinacoes(n, k);
  const cenarios = new Int32Array(totalCenarios);

  // Mapeia cada dezena para sua máscara posicional 1 << (d - 1)
  const bits = dezenasSelecionadas.map(d => 1 << (d - 1));
  let cursor = 0;

  function recursao(inicio, profundidade, maskAcumulada) {
    if (profundidade === k) {
      cenarios[cursor++] = maskAcumulada;
      return;
    }
    const limite = n - (k - profundidade);
    for (let i = inicio; i <= limite; i++) {
      recursao(i + 1, profundidade + 1, maskAcumulada | bits[i]);
    }
  }

  recursao(0, 0, 0);
  return cenarios;
}

/**
 * Audita a cobertura efetiva dos cartões filtrados contra os cenários teóricos.
 * @param {number[]} cartoesFiltradosMasks - Array de máscaras dos cartões remanescentes
 * @param {Int32Array} cenariosAcertoMasks - Buffer com todas as combinações C(V, 15)
 * @param {number} garantiaPontos - Mínimo de acertos exigido (ex: 14)
 * @returns {number} Taxa de cobertura entre 0.0 e 100.0
 */
export function auditarGarantiaEfetiva(cartoesFiltradosMasks, cenariosAcertoMasks, garantiaPontos = 14) {
  const totalCenarios = cenariosAcertoMasks.length;
  if (totalCenarios === 0 || cartoesFiltradosMasks.length === 0) return 0.0;

  let cobertos = 0;
  const totalCartoes = cartoesFiltradosMasks.length;

  for (let i = 0; i < totalCenarios; i++) {
    const cenario = cenariosAcertoMasks[i];
    let atendido = false;

    for (let j = 0; j < totalCartoes; j++) {
      // popcount da interseção binária conta as dezenas coincidentes
      if (popcount(cenario & cartoesFiltradosMasks[j]) >= garantiaPontos) {
        atendido = true;
        break; // Cenário garantido, passa para o próximo
      }
    }

    if (atendido) {
      cobertos++;
    }
  }

  return (cobertos / totalCenarios) * 100;
}

