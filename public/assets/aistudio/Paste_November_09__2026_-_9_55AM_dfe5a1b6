function conferirCartoesBitwise(cartoesMasks, resultadoOficialArray) {
  console.time("Conferência Bitwise");

  // Transforma o resultado oficial em máscara de bits
  const maskSorteio = resultadoOficialArray.reduce((acc, d) => acc | (1 << (d - 1)), 0);

  const total = cartoesMasks.length;
  const relatorio = {
    acertos15: 0,
    acertos14: 0,
    acertos13: 0,
    acertos12: 0,
    acertos11: 0,
    abaixo11: 0,
    totalJogos: total
  };

  for (let i = 0; i < total; i++) {
    // Interseção entre o volante e o sorteio oficial
    const pontos = popcount(cartoesMasks[i] & maskSorteio);

    switch (pointsToCategory(pontos)) {
      case 15: relatorio.acertos15++; break;
      case 14: relatorio.acertos14++; break;
      case 13: relatorio.acertos13++; break;
      case 12: relatorio.acertos12++; break;
      case 11: relatorio.acertos11++; break;
      default: relatorio.abaixo11++; break;
    }
  }

  console.timeEnd("Conferência Bitwise");
  return relatorio;
}

function pointsToCategory(pontos) {
  return pontos >= 11 ? pontos : 0;
}
