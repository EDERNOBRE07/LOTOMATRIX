export function atualizarIndicadorGarantia({
  porcentagem,
  jogosFiltrados,
  jogosOriginais,
  custoPorJogo = 3.00,
  garantiaAlvo = "14 se 15"
}) {
  const elemPorcentagem = document.getElementById('valorPorcentagem');
  const elemBarra = document.getElementById('barraProgresso');
  const elemDot = document.getElementById('statusDot');
  const elemJogos = document.getElementById('jogosInfo');
  const elemCusto = document.getElementById('custoTotal');
  const elemEconomia = document.getElementById('economiaFiltros');
  const elemGarantiaAlvo = document.getElementById('labelGarantiaAlvo');

  const p = Math.min(100, Math.max(0, porcentagem));
  elemPorcentagem.textContent = `${p.toFixed(1)}%`;
  elemBarra.style.width = `${p}%`;
  elemGarantiaAlvo.textContent = garantiaAlvo;
  elemJogos.textContent = jogosFiltrados;

  const custoAtual = jogosFiltrados * custoPorJogo;
  const custoBase = jogosOriginais * custoPorJogo;
  const economia = Math.max(0, custoBase - custoAtual);
  const economiaPerc = custoBase > 0 ? (economia / custoBase) * 100 : 0;

  elemCusto.textContent = `R$ ${custoAtual.toFixed(2).replace('.', ',')}`;
  elemEconomia.textContent = `R$ ${economia.toFixed(2).replace('.', ',')} (${economiaPerc.toFixed(0)}%)`;

  // Estilização condicional baseada na faixa de perda matemática
  elemBarra.className = "h-1.5 rounded-full transition-all duration-500 ease-out";
  elemPorcentagem.className = "text-3xl font-black tracking-tight transition-colors duration-300";
  elemDot.className = "inline-block w-2.5 h-2.5 rounded-full";

  if (p >= 95.0) {
    elemBarra.classList.add("bg-emerald-500");
    elemPorcentagem.classList.add("text-emerald-400");
    elemDot.classList.add("bg-emerald-400");
  } else if (p >= 80.0) {
    elemBarra.classList.add("bg-amber-400");
    elemPorcentagem.classList.add("text-amber-400");
    elemDot.classList.add("bg-amber-400");
  } else {
    elemBarra.classList.add("bg-rose-500");
    elemPorcentagem.classList.add("text-rose-400");
    elemDot.classList.add("bg-rose-500");
  }
}

