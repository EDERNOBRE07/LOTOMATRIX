function exportarFechamento(jogos, formato = 'txt', nomeArquivo = 'fechamento_lotosniper') {
  const delimitador = formato === 'csv' ? ';' : ' ';
  const quebraLinha = '\r\n';
  
  // Utiliza array de strings por linha para evitar alocação de uma única string gigante
  const linhas = [];

  if (formato === 'csv') {
    linhas.push(['Jogo', 'D01', 'D02', 'D03', 'D04', 'D05', 'D06', 'D07', 'D08', 'D09', 'D10', 'D11', 'D12', 'D13', 'D14', 'D15'].join(delimitador));
  }

  for (let i = 0; i < jogos.length; i++) {
    const jogoFormatado = jogos[i].map(d => String(d).padStart(2, '0'));
    
    if (formato === 'csv') {
      linhas.push([`Cartão ${i + 1}`, ...jogoFormatado].join(delimitador));
    } else {
      // Padrão Caixa / Loterias (apenas dezenas separadas por espaço)
      linhas.push(jogoFormatado.join(delimitador));
    }
  }

  // Gera o arquivo diretamente em formato binário UTF-8
  const conteudo = linhas.join(quebraLinha);
  const mimeType = formato === 'csv' ? 'text/csv;charset=utf-8;' : 'text/plain;charset=utf-8;';
  const blob = new Blob([conteudo], { type: mimeType });

  // Disparo programático de download sem criar elementos fixos no DOM
  const link = document.createElement('a');
  const url = URL.createObjectURL(blob);
  link.href = url;
  link.download = `${nomeArquivo}.${formato}`;
  document.body.appendChild(link);
  link.click();

  // Limpeza de memória
  setTimeout(() => {
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  }, 100);
}
