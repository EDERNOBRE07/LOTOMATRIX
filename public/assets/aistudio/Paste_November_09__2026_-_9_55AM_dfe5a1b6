function reduzirFechamentoGuloso(candidatosMasks, dezenasTotalMask, garantiaAcertos, dezenasAcertadas) {
  // 1. Gera todos os cenários possíveis de acerto (ex: C(Total, 15))
  // Para fins operacionais, candidatosMasks são os volantes que podem ser jogados.
  const numCandidatos = candidatosMasks.length;
  const cobertos = new Uint8Array(numCandidatos); // 0 = não coberto, 1 = coberto
  const selecionados = [];

  let restantes = numCandidatos;

  while (restantes > 0) {
    let melhorCandidatoIdx = -1;
    let maxCoberturaNova = -1;

    // Avalia qual cartão cobre mais combinações restantes com a garantia exigida
    for (let i = 0; i < numCandidatos; i++) {
      const c1 = candidatosMasks[i];
      let coberturaDeste = 0;

      for (let j = 0; j < numCandidatos; j++) {
        if (cobertos[j] === 0) {
          // Interseção bitwise: número de dezenas coincidentes
          const acertos = popcount(c1 & candidatosMasks[j]);
          if (acertos >= garantiaAcertos) {
            coberturaDeste++;
          }
        }
      }

      if (coberturaDeste > maxCoberturaNova) {
        maxCoberturaNova = coberturaDeste;
        melhorCandidatoIdx = i;
      }
    }

    if (melhorCandidatoIdx === -1 || maxCoberturaNova === 0) {
      break;
    }

    // Salva o melhor volante encontrado
    const melhorMask = candidatosMasks[melhorCandidatoIdx];
    selecionados.push(melhorMask);

    // Marca todos os cartões contemplados por este novo volante
    for (let j = 0; j < numCandidatos; j++) {
      if (cobertos[j] === 0) {
        if (popcount(melhorMask & candidatosMasks[j]) >= garantiaAcertos) {
          cobertos[j] = 1;
          restantes--;
        }
      }
    }
  }

  return selecionados; // Retorna array de máscaras otimizadas
}
