// workerPool.js

export class CombinatorialWorkerPool {
  constructor(workerScriptUrl, poolSize = navigator.hardwareConcurrency || 4) {
    this.poolSize = poolSize;
    this.workers = [];
    this.workerScriptUrl = workerScriptUrl;
  }

  inicializar() {
    for (let i = 0; i < this.poolSize; i++) {
      const worker = new Worker(this.workerScriptUrl, { type: 'module' });
      this.workers.push(worker);
    }
  }

  /**
   * Divide as dezenas variáveis entre os workers pelo índice raiz da recursão.
   */
  async executarFechamentoParalelo(payload) {
    const { dezenasSelecionadas, tamanhoAposta, fixas = [], filtros = {} } = payload;
    const fixasSet = new Set(fixas);
    const variaveis = dezenasSelecionadas.filter(d => !fixasSet.has(d));
    const vagas = tamanhoAposta - fixas.length;

    // Particiona os índices iniciais da recursão entre os workers
    const numParticoes = variaveis.length - vagas + 1;
    const fatiasPorWorker = Array.from({ length: this.poolSize }, () => []);

    for (let i = 0; i < numParticoes; i++) {
      fatiasPorWorker[i % this.poolSize].push(i);
    }

    const promises = this.workers.map((worker, idx) => {
      const indicesIniciais = fatiasPorWorker[idx];
      if (indicesIniciais.length === 0) return Promise.resolve(new Int32Array(0));

      return new Promise((resolve, reject) => {
        const handler = (e) => {
          if (e.data.type === 'CHUNK_COMPLETE') {
            worker.removeEventListener('message', handler);
            resolve(e.data.jogosValidos);
          } else if (e.data.type === 'ERROR') {
            worker.removeEventListener('message', handler);
            reject(new Error(e.data.message));
          }
        };

        worker.addEventListener('message', handler);
        worker.postMessage({
          indicesIniciais,
          variaveis,
          vagas,
          fixas,
          filtros
        });
      });
    });

    const resultados = await Promise.all(promises);

    // Concatena os TypedArrays em um único buffer contínuo sem estouro de pilha
    const totalJogos = resultados.reduce((acc, arr) => acc + arr.length, 0);
    const bufferFinal = new Int32Array(totalJogos);
    let offset = 0;

    for (const arr of resultados) {
      bufferFinal.set(arr, offset);
      offset += arr.length;
    }

    return bufferFinal;
  }

  destruir() {
    this.workers.forEach(w => w.terminate());
    this.workers = [];
  }
}

// workerCombinatorioChunk.js
import { popcount, validarJogoBitwise } from './bitwiseUtils.js';

self.onmessage = function (e) {
  const { indicesIniciais, variaveis, vagas, fixas, filtros } = e.data;

  const fixasMask = fixas.reduce((acc, d) => acc | (1 << (d - 1)), 0);
  const variaveisBits = variaveis.map(d => 1 << (d - 1));
  const n = variaveisBits.length;

  const bufferLocal = new Int32Array(50000);
  let encontrados = 0;

  function combinarFatia(inicio, profundidade, maskAtual) {
    if (profundidade === vagas) {
      const jogoMask = maskAtual | fixasMask;
      if (validarJogoBitwise(jogoMask, filtros)) {
        if (encontrados < bufferLocal.length) {
          bufferLocal[encontrados++] = jogoMask;
        }
      }
      return;
    }

    const limite = n - (vagas - profundidade);
    for (let i = inicio; i <= limite; i++) {
      combinarFatia(i + 1, profundidade + 1, maskAtual | variaveisBits[i]);
    }
  }

  // Executa apenas as raízes atribuídas a este worker
  for (const rootIdx of indicesIniciais) {
    combinarFatia(rootIdx + 1, 1, variaveisBits[rootIdx]);
  }

  // Devolve a fatia calculada
  const resultado = bufferLocal.slice(0, encontrados);
  self.postMessage({ type: 'CHUNK_COMPLETE', jogosValidos: resultado }, [resultado.buffer]);
};

// backtestingEngine.js
import { popcount } from './bitwiseUtils.js';

export function rodarBacktesting({
  cartoesMasks, // Int32Array com os jogos do fechamento
  historicoConcursos, // Array: [{ concurso: 3000, mask: 0b101..., premiacao: {...} }, ...]
  precoPorJogo = 3.00,
  premiosPadrao = {
    11: 6.00,
    12: 12.00,
    13: 30.00,
    14: 1500.00,
    15: 1800000.00
  }
}) {
  console.time('Tempo Backtesting');

  const totalCartoes = cartoesMasks.length;
  const custoPorConcurso = totalCartoes * precoPorJogo;
  const numConcursos = historicoConcursos.length;
  const custoTotalHistorico = custoPorConcurso * numConcursos;

  let arrecadacaoTotal = 0;
  const saldoPorConcurso = [];
  const contagemGeralAcertos = { 15: 0, 14: 0, 13: 0, 12: 0, 11: 0, abaixo11: 0 };

  for (let c = 0; c < numConcursos; c++) {
    const sorteio = historicoConcursos[c];
    const maskSorteio = sorteio.mask;
    let retornoNesteConcurso = 0;

    for (let j = 0; j < totalCartoes; j++) {
      const pontos = popcount(cartoesMasks[j] & maskSorteio);

      if (pontos >= 11) {
        contagemGeralAcertos[pontos]++;
        const premioItem = (sorteio.valoresReais && sorteio.valoresReais[pontos]) 
          ? sorteio.valoresReais[pontos] 
          : premiosPadrao[pontos];
        retornoNesteConcurso += premioItem;
      } else {
        contagemGeralAcertos.abaixo11++;
      }
    }

    arrecadacaoTotal += retornoNesteConcurso;
    saldoPorConcurso.push({
      concurso: sorteio.concurso,
      custo: custoPorConcurso,
      retorno: retornoNesteConcurso,
      lucroLiquido: retornoNesteConcurso - custoPorConcurso
    });
  }

  const saldoLiquidoFinal = arrecadacaoTotal - custoTotalHistorico;
  const roi = custoTotalHistorico > 0 ? (saldoLiquidoFinal / custoTotalHistorico) * 100 : 0;

  console.timeEnd('Tempo Backtesting');

  return {
    numConcursosAvaliados: numConcursos,
    totalCartoesPorConcurso: totalCartoes,
    custoTotalGasto: custoTotalHistorico,
    arrecadacaoBruta: arrecadacaoTotal,
    saldoLiquidoFinal,
    roiPercentual: roi,
    contagemGeralAcertos,
    curvaPatrimonial: saldoPorConcurso
  };
}

// simulatedAnnealingCover.js
import { popcount } from './bitwiseUtils.js';

/**
 * Reduz uma matriz de cartões minimizando o total de volantes para manter cobertura alvo.
 * @param {Int32Array} poolCandidatosMasks - Banco de cartões viáveis
 * @param {Int32Array} cenariosAcertoMasks - Espaço C(V, 15) que precisa ser coberto
 * @param {number} garantiaAlvo - Acertos exigidos (ex: 14)
 * @param {number} taxaCoberturaMinima - Cobertura pretendida (ex: 100 ou 90 para soft-cover)
 */
export function simulatedAnnealingReducao({
  poolCandidatosMasks,
  cenariosAcertoMasks,
  garantiaAlvo = 14,
  taxaCoberturaMinima = 100.0,
  temperaturaInicial = 100.0,
  fatorResfriamento = 0.96,
  iteracoesPorTemp = 50,
  tempMinima = 0.05
}) {
  const totalCenarios = cenariosAcertoMasks.length;
  const poolLen = poolCandidatosMasks.length;

  // 1. Solução Inicial: subconjunto aleatório de cartões
  let solucaoAtualIndices = new Set();
  const tamanhoInicial = Math.min(poolLen, Math.ceil(poolLen * 0.4));
  while (solucaoAtualIndices.size < tamanhoInicial) {
    solucaoAtualIndices.add(Math.floor(Math.random() * poolLen));
  }

  // Avaliador de Cobertura
  function avaliarSolucao(indicesSet) {
    const indicesArr = Array.from(indicesSet);
    let cobertos = 0;

    for (let c = 0; c < totalCenarios; c++) {
      const cenario = cenariosAcertoMasks[c];
      for (let i = 0; i < indicesArr.length; i++) {
        if (popcount(cenario & poolCandidatosMasks[indicesArr[i]]) >= garantiaAlvo) {
          cobertos++;
          break;
        }
      }
    }

    const cobertura = (cobertos / totalCenarios) * 100;
    // Função de Custo / Energia: Menos cartões é melhor; penalidade severa se não atingir a cobertura mínima
    const penalidade = cobertura < taxaCoberturaMinima ? (taxaCoberturaMinima - cobertura) * 500 : 0;
    const custo = indicesSet.size + penalidade;

    return { custo, cobertura, valido: cobertura >= taxaCoberturaMinima };
  }

  let estadoAtual = avaliarSolucao(solucaoAtualIndices);
  let melhorSolucaoIndices = new Set(solucaoAtualIndices);
  let melhorEstado = { ...estadoAtual };

  let T = temperaturaInicial;

  while (T > tempMinima) {
    for (let iter = 0; iter < iteracoesPorTemp; iter++) {
      // Perturbação (Mutação): Adicionar, Remover ou Trocar um cartão
      const proximoIndices = new Set(solucaoAtualIndices);
      const rand = Math.random();

      if (rand < 0.4 && proximoIndices.size > 1) {
        // Ação: Remover cartão aleatório
        const itemRemover = Array.from(proximoIndices)[Math.floor(Math.random() * proximoIndices.size)];
        proximoIndices.delete(itemRemover);
      } else if (rand < 0.8) {
        // Ação: Inserir novo cartão aleatório do pool
        const itemAdicionar = Math.floor(Math.random() * poolLen);
        proximoIndices.add(itemAdicionar);
      } else {
        // Ação: Substituir (Swap)
        const itemRemover = Array.from(proximoIndices)[Math.floor(Math.random() * proximoIndices.size)];
        proximoIndices.delete(itemRemover);
        const itemAdicionar = Math.floor(Math.random() * poolLen);
        proximoIndices.add(itemAdicionar);
      }

      const proximoEstado = avaliarSolucao(proximoIndices);
      const deltaEnergia = proximoEstado.custo - estadoAtual.custo;

      // Critério de Metrópolis: Aceita se for melhor ou com probabilidade decrescente se for pior
      if (deltaEnergia < 0 || Math.random() < Math.exp(-deltaEnergia / T)) {
        solucaoAtualIndices = proximoIndices;
        estadoAtual = proximoEstado;

        if (estadoAtual.valido && estadoAtual.custo < melhorEstado.custo) {
          melhorSolucaoIndices = new Set(solucaoAtualIndices);
          melhorEstado = { ...estadoAtual };
        }
      }
    }

    T *= fatorResfriamento; // Resfriamento gradativo
  }

  // Mapeia os índices de volta para as máscaras binárias
  const resultadoFinal = Array.from(melhorSolucaoIndices).map(idx => poolCandidatosMasks[idx]);

  return {
    totalCartoes: resultadoFinal.length,
    coberturaAlcancada: melhorEstado.cobertura,
    cartoesReduzidosMasks: new Int32Array(resultadoFinal)
  };
}

