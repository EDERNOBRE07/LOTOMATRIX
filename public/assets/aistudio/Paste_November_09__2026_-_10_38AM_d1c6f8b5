// exportadorCologaLGodoi.js

/**
 * Exporta os cartões em formato TXT posicional estrito aceito por Cologa e L-Godoi.
 * @param {Array<Array<number>>} jogos - Lista de jogos com dezenas numéricas
 * @param {string} prefixoArquivo - Nome base para download
 */
export function exportarParaCologaLGodoi(jogos, prefixoArquivo = 'matriz_lotosniper') {
  const CRLF = '\r\n';
  
  // Mapeia cada jogo para uma linha com dezenas de 2 dígitos separadas por espaço
  const linhas = jogos.map(jogo => {
    // Garante ordenação ascendente e formatação com zero à esquerda
    return [...jogo]
      .sort((a, b) => a - b)
      .map(d => String(d).padStart(2, '0'))
      .join(' ');
  });

  // Monta o arquivo em texto puro
  const conteudoTexto = linhas.join(CRLF) + CRLF;

  // Blob com charset ANSI / UTF-8 compatível com Windows antigo
  const blob = new Blob([conteudoTexto], { type: 'text/plain;charset=utf-8;' });
  const url = URL.createObjectURL(blob);

  const link = document.createElement('a');
  link.href = url;
  link.download = `${prefixoArquivo}_cologa.txt`;
  document.body.appendChild(link);
  link.click();

  // Limpeza de recursos
  setTimeout(() => {
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  }, 100);
}

