export async function executarAnnealingWasm({
  poolCandidatosMasks,
  cenariosAcertoMasks,
  garantiaAlvo = 14,
  taxaMinima = 100.0
}) {
  await init();

  const seed = (Math.random() * 0xFFFFFFFF) >>> 0;
  
  // Passa diretamente como Uint32Array (zero-copy memory mapping no WebAssembly)
  const pool = new Uint32Array(poolCandidatosMasks);
  const cenarios = new Uint32Array(cenariosAcertoMasks);

  console.time('Simulated Annealing WASM');
  const resultado = simulated_annealing_wasm(
    pool,
    cenarios,
    garantiaAlvo,
    taxaMinima,
    120.0, // Temp Inicial
    0.95,  // Fator Resfriamento
    80,    // Iterações por patamar térmico
    0.05,  // Temp Mínima
    seed
  );
  console.timeEnd('Simulated Annealing WASM');

  return {
    totalCartoes: resultado.total_cartoes,
    coberturaAlcancada: resultado.cobertura_alcancada,
    cartoesReduzidosMasks: resultado.indices.map(idx => pool[idx])
  };
}

