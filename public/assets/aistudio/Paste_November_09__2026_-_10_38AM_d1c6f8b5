// geradorVolantes.js

/**
 * Renderiza os volantes organizados em folhas A4 (3 volantes por folha).
 * @param {Array<Array<number>>} listaJogos - Matriz de jogos (ex: [[1, 2, ..., 15], ...])
 */
function renderizarFolhasImpressao(listaJogos) {
  const container = document.getElementById('conteudoImpressao');
  container.innerHTML = '';

  const JOGOS_POR_FOLHA = 3;
  const totalFolhas = Math.ceil(listaJogos.length / JOGOS_POR_FOLHA);

  for (let f = 0; f < totalFolhas; f++) {
    // 1. Cria a página A4 física
    const pagina = document.createElement('div');
    pagina.className = 'pagina-a4';

    // 2. Extrai os 3 jogos desta folha
    const fatiaJogos = listaJogos.slice(f * JOGOS_POR_FOLHA, (f + 1) * JOGOS_POR_FOLHA);

    fatiaJogos.forEach((jogo, indexRelativo) => {
      const indexReal = f * JOGOS_POR_FOLHA + indexRelativo + 1;
      const volante = criarElementoVolante(jogo, indexReal);
      pagina.appendChild(volante);
    });

    container.appendChild(pagina);
  }
}

/**
 * Cria a estrutura DOM de um volante individual da Lotofácil (1 a 25)
 */
function criarElementoVolante(dezenasJogo, numeroJogo) {
  const dezenasSet = new Set(dezenasJogo);

  const wrapper = document.createElement('div');
  wrapper.className = 'volante-container';

  wrapper.innerHTML = `
    <div class="marcador-corte-topo">✄ - - - - - - - CORTE AQUI - - - - - - - ✄</div>
    <div class="volante-header">LotoSniper • Jogo #${numeroJogo}</div>
    <div class="grid-lotofacil"></div>
    <div class="marcador-corte-base">✄ - - - - - - - - - - - - - - - - - - - ✄</div>
  `;

  const grid = wrapper.querySelector('.grid-lotofacil');

  // Constrói as 25 posições da Lotofácil
  for (let d = 1; d <= 25; d++) {
    const celula = document.createElement('div');
    celula.className = 'celula-dezena';
    celula.textContent = String(d).padStart(2, '0');

    // Se o número faz parte do jogo, ativa a marca óptica
    if (dezenasSet.has(d)) {
      celula.classList.add('marcada');
    }

    grid.appendChild(celula);
  }

  return wrapper;
}

// Inicialização com dados de exemplo (ex: 6 jogos gerados)
const jogosExemplo = [
  [1, 2, 3, 5, 8, 9, 10, 11, 13, 15, 17, 19, 21, 22, 25],
  [1, 3, 4, 6, 7, 10, 11, 12, 14, 16, 18, 20, 22, 23, 24],
