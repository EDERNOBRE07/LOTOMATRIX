const DB_NAME = 'LotoSniperDB';
const CURRENT_VERSION = 2; // Incrementar ao adicionar novas stores ou índices

export class LotoSniperDatabase {
  constructor() {
    this.db = null;
  }

  /**
   * Abre o banco de dados aplicando migrações sequenciais conforme a versão instalada.
   */
  async conectar() {
    if (this.db) return this.db;

    return new Promise((resolve, reject) => {
      const request = indexedDB.open(DB_NAME, CURRENT_VERSION);

      request.onupgradeneeded = (event) => {
        const db = event.target.result;
        const oldVersion = event.oldVersion;

        console.log(`[DB] Migrando banco de dados da versão ${oldVersion} para ${CURRENT_VERSION}`);

        // Migração Versão 1: Estrutura Base de Concursos e Fechamentos
        if (oldVersion < 1) {
          const storeConcursos = db.createObjectStore('concursos', { keyPath: 'numero' });
          storeConcursos.createIndex('idx_data', 'dataApuracao', { unique: false });
          storeConcursos.createIndex('idx_mask', 'mask', { unique: false });

          const storeFechamentos = db.createObjectStore('fechamentosSalvos', {
            keyPath: 'id',
            autoIncrement: true
          });
          storeFechamentos.createIndex('idx_criadoEm', 'criadoEm', { unique: false });
        }

        // Migração Versão 2: Armazenamento de Parâmetros de Backtesting e Índices de Auditoria
        if (oldVersion < 2) {
          if (!db.objectStoreNames.contains('historicoBacktest')) {
            const storeBacktest = db.createObjectStore('historicoBacktest', {
              keyPath: 'id',
              autoIncrement: true
            });
            storeBacktest.createIndex('idx_fechamentoId', 'fechamentoId', { unique: false });
            storeBacktest.createIndex('idx_roi', 'roiPercentual', { unique: false });
          }
        }
      };

      request.onsuccess = (event) => {
        this.db = event.target.result;
        resolve(this.db);
      };

      request.onerror = (event) => {
        reject(new Error(`Erro ao abrir IndexedDB: ${event.target.error}`));
      };
    });
  }

  /**
   * Salva uma lista completa de concursos em uma única transação de alto desempenho.
   * @param {Array<Object>} concursos - Lista [{ numero, dataApuracao, dezenas, mask, premiacao }, ...]
   */
  async importarConcursosLote(concursos) {
    const db = await this.conectar();

    return new Promise((resolve, reject) => {
      const tx = db.transaction('concursos', 'readwrite');
      const store = tx.objectStore('concursos');

      concursos.forEach(c => {
        // Normaliza máscara binária para consulta rápida
        const mask = c.mask || c.dezenas.reduce((acc, d) => acc | (1 << (d - 1)), 0);
        store.put({
          numero: c.numero,
          dataApuracao: c.dataApuracao,
          dezenas: c.dezenas,
          mask: mask,
          valoresReais: c.valoresReais || null
        });
      });

      tx.oncomplete = () => resolve(concursos.length);
      tx.onerror = (e) => reject(e.target.error);
    });
  }

  /**
   * Obtém os últimos N concursos ordenados de forma decrescente para o Backtesting.
   */
  async obterUltimosConcursos(limite = 100) {
    const db = await this.conectar();

    return new Promise((resolve, reject) => {
      const tx = db.transaction('concursos', 'readonly');
      const store = tx.objectStore('concursos');
      const request = store.openCursor(null, 'prev'); // Ordenação decrescente por chave primária
      const resultados = [];

      request.onsuccess = (e) => {
        const cursor = e.target.result;
        if (cursor && resultados.length < limite) {
          resultados.push(cursor.value);
          cursor.continue();
        } else {
          resolve(resultados);
        }
      };

      request.onerror = (e) => reject(e.target.error);
    });
  }

  /**
   * Retorna o número do concurso mais recente persistido no IndexedDB.
   */
  async obterMaiorConcursoArmazenado() {
    const db = await this.conectar();

    return new Promise((resolve, reject) => {
      const tx = db.transaction('concursos', 'readonly');
      const store = tx.objectStore('concursos');
      const request = store.openCursor(null, 'prev');

      request.onsuccess = (e) => {
        const cursor = e.target.result;
        resolve(cursor ? cursor.key : 0);
      };

      request.onerror = (e) => reject(e.target.error);
    });
  }
}

