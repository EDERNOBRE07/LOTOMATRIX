import { dbService } from './database.js';
import { obterDadosLotofacil } from './caixaService.js';

export async function sincronizarBaseHistoricaIncremental() {
  const maiorLocal = await dbService.obterMaiorConcursoArmazenado();
  const ultimoCaixa = await obterDadosLotofacil(); // Busca o mais recente da API

  if (maiorLocal >= ultimoCaixa.concurso) {
    console.log(`[LotoSniper] Base histórica sincronizada até o concurso #${maiorLocal}.`);
    return;
  }

  console.log(`[LotoSniper] Atualizando base do concurso #${maiorLocal + 1} até #${ultimoCaixa.concurso}...`);

  const pendentes = [];
  for (let num = maiorLocal + 1; num <= ultimoCaixa.concurso; num++) {
    try {
      const dados = await obterDadosLotofacil(num);
      pendentes.push({
        numero: dados.concurso,
        dataApuracao: dados.dataApuracao,
        dezenas: dados.dezenas,
        mask: dados.maskConcurso,
        valoresReais: null
      });
    } catch (err) {
      console.warn(`Falha ao buscar concurso #${num}:`, err);
    }
  }

  if (pendentes.length > 0) {
    await dbService.importarConcursosLote(pendentes);
    console.log(`[LotoSniper] ${pendentes.length} novos concursos persistidos com sucesso.`);
  }
}
