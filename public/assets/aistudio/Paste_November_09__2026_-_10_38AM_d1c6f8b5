<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Impressão de Volantes - LotoSniper</title>
  <style>
    /* Reset Geral de Tela */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      background-color: #1e293b;
      padding: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .painel-acoes {
      margin-bottom: 20px;
    }

    .btn-imprimir {
      background-color: #0284c7;
      color: #fff;
      border: none;
      padding: 10px 20px;
      font-size: 14px;
      font-weight: bold;
      border-radius: 6px;
      cursor: pointer;
    }

    /* Estrutura da Página A4 */
    .pagina-a4 {
      width: 210mm;
      height: 297mm;
      background: white;
      padding: 10mm 15mm;
      display: flex;
      justify-content: space-between;
      page-break-after: always;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    /* Cada Volante Individual na Folha (Largura padrão Caixa: ~56mm útil, 81mm total) */
    .volante-container {
      width: 56mm;
      height: 270mm;
      border: 0.2mm dashed #94a3b8; /* Linha de corte */
      padding: 25mm 2mm 5mm 2mm; /* 25mm superior reserva espaço para cabeçalho da Caixa */
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
    }

    .volante-header {
      font-size: 8pt;
      font-weight: bold;
      text-transform: uppercase;
      margin-bottom: 6mm;
      color: #334155;
    }

    /* Grid da Lotofácil (5 Colunas x 5 Linhas) */
    .grid-lotofacil {
      display: grid;
      grid-template-columns: repeat(5, 9mm);
      grid-template-rows: repeat(5, 7.5mm);
      column-gap: 1.5mm;
      row-gap: 1.8mm;
      justify-content: center;
    }

    .celula-dezena {
      width: 9mm;
      height: 7.5mm;
      border: 0.15mm solid #cbd5e1;
      border-radius: 1mm;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 7.5pt;
      font-weight: bold;
      color: #64748b;
      position: relative;
    }

    /* A Marcação Óptica: Retângulo Preto Sólido */
    .celula-dezena.marcada {
      background-color: #000 !important;
      color: #000 !important; /* Esconde o número preenchendo de preto */
      border: 0.2mm solid #000 !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    /* Linhas de Alinhamento para Corte */
    .marcador-corte-topo, .marcador-corte-base {
      position: absolute;
      width: 100%;
      text-align: center;
      font-size: 6pt;
      color: #94a3b8;
    }
    .marcador-corte-topo { top: 2mm; }
    .marcador-corte-base { bottom: 2mm; }

    /* ==============================================
       REGRAS ESTRITAS DE IMPRESSÃO
       ============================================== */
    @media print {
      @page {
        size: A4 portrait;
        margin: 0; /* Anula margens automáticas da impressora */
      }

      body {
        background: transparent;
        padding: 0;
      }

      .painel-acoes {
        display: none !important;
      }

      .pagina-a4 {
        box-shadow: none;
        page-break-after: always;
        width: 210mm;
        height: 297mm;
        padding: 10mm 15mm;
      }
    }
  </style>
</head>
